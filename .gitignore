# Entorno
.env
.env.local

# Spike desechable del canal de Teams (iniciativa 013, T0). No se versiona:
# el código del servicio real vive en src/agent_review/teams_bot/ a partir de T5.
spikes/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime
var/

# Binario local de twg (se copia a mano; ver bin/README.md)
bin/twg

# Enlazado local de skills y preferencias de Claude Code. Los symlinks de skills
# apuntan a ~/.agents/skills (fuera del repo), asi que no son portables; el
# contenido real se versiona en .agents/skills + skills-lock.json.
# Excepcion: .claude/rules/ son enlaces RELATIVOS a .agents/rules (portables).
.claude/*
!.claude/rules/
