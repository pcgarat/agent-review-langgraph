# Los valores `change-me` son placeholders: hay que rellenarlos con el valor real.
# Cuentan como «sin configurar» en todas partes: `make bootstrap` los lista como
# pendientes y, con ENVIRONMENT=production, el arranque falla si un secreto
# obligatorio sigue en `change-me`. Las variables que se dejan vacias a proposito
# lo explican en su comentario (vacio = desactivado o valor por defecto).

# Atlassian / twg
TWG_BIN=twg
# Proveedor de VCS del despliegue: `twg` (Bitbucket) o `github` (API REST).
VCS_PROVIDER=github
# Identidad de servicio de twg para Bitbucket (Fase 1: leer diff, publicar).
# API token SCOPED de un actor de servicio (no el OAuth personal): no caduca
# cada hora y se revoca sin tocar a nadie. twg lo lee de TWG_BBC_TOKEN.
#   twg setup bitbucket   # o crea el token en Bitbucket > API tokens
TWG_BBC_TOKEN=change-me
TWG_SITE=cqm.atlassian.net
TWG_USER=change-me
# API token de Atlassian para `twg jira` (escalado a workitem). Opcional.
TWG_TOKEN=change-me

# Entorno de despliegue. En `production` el arranque falla si un secreto
# obligatorio sigue sin rellenar o en su valor de ejemplo (D4); en `development`
# se relajan a proposito.
ENVIRONMENT=development

# Bitbucket
BITBUCKET_WORKSPACE=cqm
BITBUCKET_REPO=emotivoo-v2

# GitHub (VCS_PROVIDER=github). Identidad del repo revisado y PAT fine-grained
# con `pull_requests: write` (comentar el PR) + `contents: read` (leer el fichero
# en Fase 3). GITHUB_API_URL se cambia para GitHub Enterprise Server.
GITHUB_OWNER=pcgarat
GITHUB_REPO=agent-review-langgraph
GITHUB_TOKEN=change-me
GITHUB_API_URL=https://api.github.com

# Teams (bot con hilo por PR, iniciativa 013). TEAMS_ENABLED=true declara el
# canal; el worker encola los avisos en TEAMS_NOTICES_KEY y el bot los publica.
TEAMS_ENABLED=false
TEAMS_NOTICES_KEY=reviews:notices
# Espera del bot al leer la outbox (segundos, poll bloqueante).
TEAMS_BOT_POLL_S=5
# Identidad del bot (Teams App ID / Azure Bot). Los escribe `teams app create`;
# el SDK elige el metodo de auth: con TEAMS_BOT_TOKEN usa *client secret*; sin el,
# identidad gestionada. Los lee SOLO el proceso teams-bot.
TEAMS_BOT_ID=change-me
TEAMS_BOT_TENANT_ID=change-me
TEAMS_BOT_TOKEN=change-me
# Puerto del messaging endpoint (POST /api/messages) dentro del contenedor.
TEAMS_BOT_PORT=3978
# Bearer del ingress INTERNO del bot (healthz y observabilidad): el egress va por
# la outbox y no lo usa. Con el valor de ejemplo, solo en development.
TEAMS_BOT_SHARED_SECRET=change-me

# Infra. POSTGRES_PASSWORD solo se usa si levantas el compose con un password
# distinto del de desarrollo; `docker compose` lo inyecta en Postgres y en las
# URLs de api/worker. Redis no tiene auth (red interna de compose).
POSTGRES_PASSWORD=reviews
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://reviews:reviews@postgres:5432/reviews
LOG_LEVEL=INFO
REVIEWS_URL=http://localhost:8000

# Progreso del worker (iniciativa 019): cierra D16 («el latido mide vida, no
# avance»). Con PROGRESS_ENABLED el worker deja en Redis, por review, el nodo en
# curso y su started_at (clave `PROGRESS_KEY`); es lo que lee el panel de
# operación. Sin el, el worker se comporta igual que antes (NullProgress).
PROGRESS_ENABLED=true
# TTL de la marca de progreso (segundos): por encima del peor caso de un nodo con
# reintentos. Una marca caducada no se confunde con un trabajo vivo.
PROGRESS_TTL_S=3600
PROGRESS_KEY=reviews:active
# TTL de la marca de cancelacion `reviews:cancel:<review_key>` (segundos). La marca
# queda tras abortar como tombstone: un job rezagado de la misma review (reanudacion
# del fix-worker, decision encolada) se aborta en vez de re-ejecutar la review.
# Debe superar DECISION_TTL_S. Reintentar desde el panel la retira. Por defecto 7 dias.
CANCEL_TTL_S=604800

# Panel de operacion (iniciativa 019). Servicio `web` aparte, opt-in por perfil de
# compose: `docker compose --profile panel up -d`. Sin el perfil, `docker compose up`
# arranca lo de siempre. PANEL_ENABLED lo declara el despliegue y es lo que exige su
# secreto de sesion en produccion.
PANEL_ENABLED=true
# Razonamiento de los revisores en el panel (021): el worker escribe lo que razona
# el modelo en cada lote en `reviews:reasoning:<review_key>` y el panel lo muestra
# en vivo. Se conserva 10 dias (REASONING_TTL_S) con un tope de 10 MB por review.
REASONING_STREAM_ENABLED=false
REASONING_TTL_S=864000
REASONING_MAX_BYTES=10485760
# Puerto del panel dentro del contenedor; el perfil `panel` lo publica en el host.
PANEL_PORT=8090
# Token opaco de la sesion del panel: NO es REVIEWS_DECISION_TOKEN ni el nombre de
# quien actua. Con `change-me` la sesion se relaja (solo en development). En
# produccion, un valor aleatorio; la cabecera `X-Panel-Session` debe coincidir
# con el (hmac.compare_digest). El actor publicado es PANEL_SESSION_USER y el rol,
# PANEL_SESSION_ROLE. Un `lector` puede mirar pero no ejecutar comandos.
PANEL_SESSION_SECRET=change-me
# Nombre que se publica como actor de una decision. No forma parte del secreto.
PANEL_SESSION_USER=ana
# `lector` o `operador`. Vacio: si el secreto legado tiene forma `<usuario>:<rol>`,
# se usa solo ese rol; el usuario publicado sigue siendo PANEL_SESSION_USER o `panel`.
PANEL_SESSION_ROLE=operador
# Diales que el panel muestra y no deja cambiar (027). Lista de nombres de campo,
# separada por comas. Vacio: el operador puede publicar el catalogo. Un nombre
# que no sea un dial aborta el arranque del web y del worker.
PANEL_CONFIG_LOCK=
# Tope de la consola en vivo por verificacion (lineas del buffer del runner).
SANDBOX_CONSOLE_BUFFER_LINES=2000

# Checkpointer durable del grafo (Fase 2: HITL). Con DATABASE_URL, el worker
# persiste el estado por `thread_id` para no re-ejecutar una review ya hecha
# (reintentos, reentrega del mensaje) y para poder reanudar un grafo pausado.
# Si no hay base de datos, cae a un checkpointer en memoria.

# Sandbox (Fase 3: verificacion del fix). El worker habla con el servicio
# `sandbox-runner` por HTTP interno; sin SANDBOX_RUNNER_URL el nodo `fix` marca
# `NOT_VERIFIABLE` y no ejecuta nada. El token es compartido worker<->runner.
SANDBOX_ENABLED=false
SANDBOX_RUNNER_URL=http://sandbox-runner:8099
SANDBOX_RUNNER_TOKEN=change-me
# Bearer de SOLO LECTURA de la consola en vivo del runner (panel, 019). Lo usa el
# servicio `web` para reenviar el SSE de `GET /verify/{run_key}/console`; no sirve
# para lanzar verificaciones. Sin el, la consola del panel responde 404.
SANDBOX_CONSOLE_TOKEN=change-me
# Registro de la imagen del CI (pull). Los usa el runner, no el worker: la imagen
# se baja en el host del runner (rootless) y ningun contenedor del PR la toca.
# Con `change-me` no se hace `docker login` (imagen publica o ya autenticada).
SANDBOX_REGISTRY_USER=change-me
SANDBOX_REGISTRY_TOKEN=change-me
# Token de Bitbucket de SOLO LECTURA que usa el runner para clonar el PR. Debe ser
# distinto del de `twg` del worker e ir sin permiso de push (Q3).
SANDBOX_GIT_TOKEN=change-me
# Binario de Docker del runner (rootless en el host del runner).
SANDBOX_DOCKER_BIN=docker
# Techo de una verificacion (segundos) si el perfil no lo declara. El perfil
# (`sandbox.timeout_s`) manda; esto es el fallback sin perfil.
SANDBOX_TIMEOUT_S=1200
# Workspace de lectura (iniciativa 016): clon *bare* que el runner sirve para que
# un modelo lea ficheros y haga `grep` sin ejecutar codigo del PR. TTL de un
# workspace abierto (segundos) y tope de clones abiertos a la vez (reaper perezoso).
SANDBOX_WORKSPACE_TTL_S=1800
SANDBOX_MAX_WORKSPACES=4
# Formato de entrega del parche verificado: `diff` (fallback seguro, por defecto)
# o `suggestion` (si Bitbucket renderiza suggested changes; sin confirmar).
FIX_DELIVERY=diff
# Recipes de verificacion, en orden (nombres del repo_profile).
FIX_RECIPES=typecheck,arch,lint,targeted,tests
# Perfil del repo revisado: imagen del CI, recipes y limites del sandbox (ADR-0011).
REPO_PROFILE_CONFIG=config/repo_profile.emotivoo-v2.yaml
# Tope de lineas de un parche de fix (espejo del guard `max_fix_lines` de autonomy.yaml).
MAX_FIX_LINES=30
# Fase 3-E7: TTL del handoff del fix. Una wave sin resolver en este plazo se
# reanuda con `outcome="error"` (el fix queda `NOT_VERIFIABLE`, publicado).
FIX_VERIFY_TTL_S=7200
# Reintentos del job de fix ante un fallo transitorio del runner (DLQ al agotar).
MAX_FIX_ATTEMPTS_JOB=3
# Cadencia del bucle del fix-worker (poll de la cola) y de su barrido.
FIX_POLL_S=5
FIX_SWEEP_S=30

# Salida de herramientas estaticas (Fase 1: artefacto que deposita el CI).
# Placeholders: {tool}, {pr_id}, {head_sha}
TOOLING_OUTPUT_TEMPLATE=var/tooling/{pr_id}/{head_sha}/{tool}.json
# Raiz desde la que se resuelve TOOLING_OUTPUT_TEMPLATE.
TOOLING_OUTPUT_ROOT=.

# Ingesta diferida: el CI publica el artefacto en POST /webhook/tooling.
# Secreto compartido para firmar ese POST (HMAC-SHA256); el CI lo envia en
# la cabecera X-Reviews-Signature.
TOOLING_WEBHOOK_SECRET=change-me
# Bearer del canal de decision HITL (CLI/POST /reviews/{key}/decision). En Fase 2
# autoriza a mandar sobre el clamp; en Fase 3 es la llave del repo -> tratarlo
# como secreto de alto valor (rotacion y scope minimo). Con el valor de ejemplo
# el endpoint no exige token (solo en development).
REVIEWS_DECISION_TOKEN=change-me
# TTL de una decision pendiente (segundos). Pasado, la review se reanuda como
# "sin decision" (expired) en vez de quedarse colgada. Por defecto 7 dias.
DECISION_TTL_S=604800
# Retencion de checkpoints de hilos COMPLETADOS (dias). Un hilo pausado nunca se
# poda. Por defecto 30 dias.
CHECKPOINT_RETENTION_DAYS=30
# Retencion de hilos pausados en fix_wait (segundos, Fase 3-E7). A diferencia de
# una pausa humana, un hilo de fix no espera a nadie: su wave se resolvio o vencio
# y la review quedo publicada, asi que se poda pasado este plazo (0 lo desactiva).
# Debe superar con holgura FIX_VERIFY_TTL_S. Por defecto 3 dias.
FIX_WAIT_MAX_AGE_S=259200
# Herramientas cuya salida espera la review antes de ejecutarse (coma-separadas).
EXPECTED_TOOLS=phpstan
# Reintentos de una review ante un fallo transitorio (twg, Teams). Agotados, el
# job se descarta con el review_key en el log para reencolarlo a mano.
MAX_REVIEW_ATTEMPTS=3
# Reintentos por NODO dentro de una invocacion (fallo transitorio de twg, LLM o
# Teams): recupera la llamada concreta sin reencolar la review. Ortogonal a
# MAX_REVIEW_ATTEMPTS (aquel reencola el job entero). NODE_RETRY_MAX_ATTEMPTS=1
# desactiva la politica de nodo.
NODE_RETRY_MAX_ATTEMPTS=3
NODE_RETRY_INITIAL_INTERVAL_S=0.5
NODE_RETRY_BACKOFF_FACTOR=2.0
NODE_RETRY_MAX_INTERVAL_S=8.0
# Techo de una llamada a twg. Sin el, un twg colgado bloquea el nodo (y el worker,
# que es secuencial) para siempre: RetryPolicy no puede con un proceso que no lanza.
TWG_TIMEOUT_S=60
# Limite del cuerpo del POST de tooling, en bytes (413 por encima).
MAX_TOOLING_PAYLOAD_BYTES=5242880
# Patrones extra (coma-separados) que el scope ignora, ademas de los por defecto
# (composer.lock, var/**, vendor/**, generados...).
SCOPE_IGNORE=
# Politica de autonomia (reglas por hallazgo y techo `max_autonomy`). Se edita y
# se reinicia (ADR-0015).
AUTONOMY_CONFIG=config/autonomy.yaml
# Override del techo de autonomia: solo puede BAJAR el max_autonomy del YAML,
# nunca subirlo (D1). Vacio = manda config/autonomy.yaml.
MAX_AUTONOMY_OVERRIDE=
# Cuanto se espera a los artefactos antes de degradar la review.
INGEST_TTL_READY_S=1200
INGEST_TTL_PENDING_S=86400

# Motor de review (025, ADR-0028). `llm` compila el grafo de personas de hoy.
# `claude` corre un CLI fuera del worker y el grafo solo lee hallazgos ya
# validados. Se lee al arrancar: cambiarlo es reiniciar el worker. Otro valor
# aborta el arranque. `claude` no cae al grafo de personas.
REVIEW_ENGINE=claude
# Raiz de los artefactos ya validados del motor claude. Dentro, el worker
# elige repo/pr/head_sha; el CLI no escribe esa ruta. En compose el worker
# la recibe como /var/claude-artifacts: ./var va en solo lectura y un volumen
# anidado ahi no puede crear el punto de montaje.
CLAUDE_ARTIFACT_ROOT=var/claude
# Techos del subproceso `claude`: turnos y tiempo de pared (segundos).
# Valor inicial del panel (`/config`, sección Claude). Una review corta no
# los gasta. Agotarlos parkea el job y no lo reintenta.
# El runner exige el sandbox de red (solo api.anthropic.com). La ficha
# descarga la conversación entera, con sesión. No es el presupuesto de tokens.
CLAUDE_TIMEOUT_S=3600
CLAUDE_MAX_TURNS=200
# Comando del CLI dentro de `claude-runner`. El paquete apt es `claude-code`;
# el ejecutable que instala, y el que hay que poner aqui, es `claude`.
CLAUDE_BIN=claude
# Arbol de trabajo de ese servicio. No es el clon bare del sandbox-runner
# ni `CLAUDE_ARTIFACT_ROOT`.
CLAUDE_WORKSPACE_ROOT=var/claude-checkout
CLAUDE_RUNNER_PORT=8098
# El worker llama aqui antes del grafo. Vacio con REVIEW_ENGINE=llm.
CLAUDE_RUNNER_URL=http://claude-runner:8098
# Bearer compartido worker ↔ claude-runner. No es la credencial de clonado.
CLAUDE_RUNNER_TOKEN=change-me
# Override de solo lectura para el fetch. Vacio: el runner reutiliza
# GITHUB_TOKEN o TWG_BBC_TOKEN (ADR-0032). El worker lo recibe vacio.
# El subproceso `claude` no hereda ninguna de las dos.
CLAUDE_GIT_TOKEN=
# Fichero 0600 de la sesión. Lo montan el panel (escritura) y claude-runner
# (lectura). El worker no lo monta ni lo lee: pregunta GET /session.
CLAUDE_SESSION_PATH=var/claude-session/session.json
# Segundos que el panel anota al guardar. Caducado, el runner borra el fichero.
CLAUDE_SESSION_TTL_S=43200
# Enlace que lleva el aviso de Teams. Vacío: el aviso sale sin URL.
PANEL_PUBLIC_URL=http://localhost:8090
# Persona LLM `correctness` y fixer (opt-in; desactivados por defecto en Fase 1).
# `MODELS_CONFIG` es el registro declarativo: proveedores, modelos (con sus
# capacidades) y el modelo de cada ROL en config/models.yaml. El YAML referencia
# los secretos como `${VAR}` (p. ej. `${LLM_API_KEY}`), nunca en claro. Sin
# declarar o vacio (el valor por defecto) = via de compatibilidad: un solo modelo
# desde LLM_MODEL/LLM_BASE_URL/LLM_API_KEY.
# Cambiar de modelo es editar config/models.yaml y reiniciar el worker.
MODELS_CONFIG=config/models.yaml
# Via de compatibilidad sin registro declarativo (MODELS_CONFIG vacio): un solo
# modelo para todos los roles.
LLM_REVIEWER_ENABLED=false
LLM_MODEL=
# Cualquier endpoint compatible con OpenAI /chat/completions (OpenAI, Azure,
# Groq, vLLM, Ollama...). Vacio = https://api.openai.com/v1
LLM_BASE_URL=
# Clave del proveedor LLM: la referencia `${LLM_API_KEY}` del registro y, sin el,
# la credencial del unico modelo. Un proveedor nuevo anade su propio campo.
LLM_API_KEY=change-me
LLM_MAX_FINDINGS=10
LLM_BUDGET_TOKENS_PER_PR=2000000
# Tamano maximo de un lote de la persona LLM (caracteres de diff). Se revisan
# ficheros enteros por lotes; uno que no cabe se trocea por hunks. Con razonamiento,
# 20000: con lotes mayores el proveedor corta la llamada (por salida o por duracion).
LLM_BATCH_MAX_CHARS=20000
# Reintentos de un lote ante un corte transitorio del proveedor: se repite ese lote,
# no la review entera. Agotados, el lote queda sin revisar y se sigue con el resto.
LLM_BATCH_RETRIES=2
# Tope del bloque L1 (fichero completo + context_docs del perfil) por lote, en
# caracteres. El diff no se recorta; si el contexto no cabe, se omite y se loguea.
LLM_CONTEXT_MAX_CHARS=40000

# Verificador adversarial L2 (009): solo aplica con binding `verifier` en
# MODELS_CONFIG. Tope de hallazgos por review (los mas graves primero); el resto
# queda unverified sin llamada. Los topes de herramientas/bytes acotan el bucle
# ReAct por hallazgo. VERIFIER_REQUIRE_VERIFIED_FOR es el umbral de candidatos
# mientras autonomy.yaml no declare severity_gate.require_verified_for (011).
VERIFIER_MAX_FINDINGS=5
VERIFIER_MAX_TOOL_CALLS=8
VERIFIER_MAX_CONTEXT_BYTES=60000
VERIFIER_REQUIRE_VERIFIED_FOR=P0,P1

# Revisor con herramientas de lectura (014): roles LLM que pueden pedir ficheros
# y grep mientras revisan (lista separada por comas). Vacio = una llamada por
# lote como en 008 (cero cambio de coste). El primero que se activa al medir es
# correctness; un segundo rol exige el presupuesto compartido de 017 ya medido.
REVIEW_TOOLS_ROLES=
# Topes del bucle ReAct por lote (turnos sin contar el final forzado, peticiones
# de herramienta y bytes servidos).
REVIEW_TOOLS_MAX_TURNS=4
REVIEW_TOOLS_MAX_CALLS=8
REVIEW_TOOLS_MAX_BYTES=60000
# Palancas del bucle de lectura (023). No cambian lo que el prompt anuncia que
# existe: deciden coste y forma de servir. Con todas en su default, el
# comportamiento servido es el de hoy.
# Modo por defecto de grep: literal (hoy) | regex.
REVIEW_TOOLS_GREP_MODE=literal
# Habilitar mode="outline" en read_file. Apagado, se sirve full y se avisa.
REVIEW_TOOLS_READ_OUTLINE=false
# Bloque de lecturas de la review en el prompt. Apagado, no viaja.
REVIEW_TOOLS_READ_STATE=false
# Anunciar el corte con el tamano real del fichero. Apagado, el corte se aplica
# igual pero no se anuncia (solo para reproducir el prompt viejo).
REVIEW_TOOLS_TRUNCATION_NOTICE=true
# Error explicito por peticion no atendida. Apagado, el excedente se descarta
# con un AVISO (comportamiento de hoy).
REVIEW_TOOLS_STRICT_CALLS=false
# Peticiones por turno. Se sube junto con REVIEW_TOOLS_MAX_CALLS: con mas por
# turno y el mismo total, el lote se agota antes.
REVIEW_TOOLS_CALLS_PER_TURN=3
# Precarga L1 en el bucle. Apagada, el prompt base baja y el modelo lee lo que
# necesite (cuesta turnos).
REVIEW_TOOLS_PRECACHE_CONTEXT=true
# Cache de E/S por review. Ahorra E/S, no prompt.
REVIEW_TOOLS_IO_CACHE=false
