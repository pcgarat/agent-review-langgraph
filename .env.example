# Atlassian / twg
TWG_BIN=twg
# El usuario y el site los resuelve twg desde su propio auth.conf.

# Bitbucket
BITBUCKET_WORKSPACE=cqm
BITBUCKET_REPO=emotivoo-v2
# Secreto compartido con la configuracion del webhook de Bitbucket.
BITBUCKET_WEBHOOK_SECRET=change-me

# Teams (Incoming Webhook, un sentido)
TEAMS_WEBHOOK_URL=

# Infra
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://reviews:reviews@postgres:5432/reviews
LOG_LEVEL=INFO

# Sandbox
SANDBOX_ENABLED=false
SANDBOX_REGISTRY_USER=
SANDBOX_REGISTRY_TOKEN=

# Salida de herramientas estaticas (Fase 1: artefacto que deposita el CI).
# Placeholders: {tool}, {slug}, {pr_id}, {head_sha}
TOOLING_OUTPUT_TEMPLATE=var/tooling/{slug}/{pr_id}/{head_sha}/{tool}.json
