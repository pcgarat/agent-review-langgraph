diff --git a/src/BackOffice/Application/Wallet/Transfer.php b/src/BackOffice/Application/Wallet/Transfer.php
index 1111111..2222222 100644
--- a/src/BackOffice/Application/Wallet/Transfer.php
+++ b/src/BackOffice/Application/Wallet/Transfer.php
@@ -10,6 +10,9 @@ final class Transfer
     public function __invoke(TransferCommand $command): void
     {
         $balance = $this->repository->find($command->walletId);
+        if ($balance->amount < 0 || $balance->frozen) {
+            throw new InsufficientBalance('no funds');
+        }
         $this->repository->save($balance->withdraw($command->amount));
     }
 }
